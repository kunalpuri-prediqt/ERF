# ===========================================================================
# Euler Equations on a Periodic Box -- Advecting Isentropic Vortex
# ===========================================================================
#
# Purpose:
#   Compressible Euler equations (inviscid, no gravity) with an isentropic
#   vortex initial condition advecting at 45 degrees.
#   Has a known analytical solution for convergence studies.
#
# Key settings:
#   a) Single level grid (no AMR)
#   b) Fixed time step (no acoustic sub-step)
#   c) Advection scheme explicitly set
#
# To run a convergence study, vary amr.n_cell (e.g. 32, 64, 128, 256)
# while keeping fixed_dt proportional to dx (e.g. halve dt when doubling cells).
# ===========================================================================

erf.prob_name = "Advecting Isentropic Vortex"

erf.init_type = Uniform

max_step  = 200
stop_time = 10.0

amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024

# ---------------------------------------------------------------------------
# PROBLEM SIZE & GEOMETRY  (periodic box [-12, 12]^2 x [-1, 1])
# ---------------------------------------------------------------------------
geometry.prob_lo = -12  -12  -1
geometry.prob_hi =  12   12   1
amr.n_cell       =  48   48   4

geometry.is_periodic = 1 1 1      # fully periodic

# ---------------------------------------------------------------------------
# SINGLE LEVEL (no AMR)
# ---------------------------------------------------------------------------
amr.max_level = 0

# ---------------------------------------------------------------------------
# TIME STEP CONTROL
# ---------------------------------------------------------------------------
erf.substepping_type = None
erf.fixed_dt         = 0.0005

# ---------------------------------------------------------------------------
# ADVECTION SCHEME  (change these to compare schemes)
# ---------------------------------------------------------------------------
erf.dycore_horiz_adv_type    = "Upwind_5th"
erf.dycore_vert_adv_type     = "Upwind_5th"
erf.dryscal_horiz_adv_type   = "Upwind_5th"
erf.dryscal_vert_adv_type    = "Upwind_5th"

# ---------------------------------------------------------------------------
# PHYSICS -- pure Euler
# ---------------------------------------------------------------------------
erf.anelastic      = 0
erf.use_gravity    = false
erf.les_type       = "None"
erf.molec_diff_type = "None"
erf.alpha_T        = 0.0
erf.alpha_C        = 0.0

# ---------------------------------------------------------------------------
# DIAGNOSTICS
# ---------------------------------------------------------------------------
erf.sum_interval = 1
erf.v            = 1
amr.v            = 1

# ---------------------------------------------------------------------------
# CHECKPOINT
# ---------------------------------------------------------------------------
erf.check_file = chk
erf.check_int  = -1

# ---------------------------------------------------------------------------
# PLOTFILES
# ---------------------------------------------------------------------------
erf.plot_file_1 = plt
erf.plot_int_1  = 10
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure theta temp scalar

# ---------------------------------------------------------------------------
# PROBLEM PARAMETERS (Isentropic Vortex)
# ---------------------------------------------------------------------------
prob.p_inf = 1e5      # reference pressure [Pa]
prob.T_inf = 300.     # reference temperature [K]
prob.M_inf = 1.1952286093343936  # freestream Mach number [-]
prob.alpha = 0.7853981633974483  # inflow angle (pi/4 = 45 deg) [rad]
prob.beta  = 1.1088514254079065  # non-dimensional max perturbation strength [-]
prob.R     = 1.0      # characteristic length scale [m]
prob.sigma = 1.0      # Gaussian standard deviation [-]
